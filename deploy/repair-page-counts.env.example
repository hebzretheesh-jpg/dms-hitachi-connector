# Settings for repair-page-counts.
# Copy to repair-page-counts.env and fill in the SAME values the connector
# (hcp-connector service) uses on this server:  sudo systemctl cat hcp-connector
#
# Load and run:
#   set -a; . ./repair-page-counts.env; set +a
#   ./repair-page-counts-linux-amd64 -dry-run

# --- Required ---------------------------------------------------------------
HITACHI_ENDPOINT=https://your-hcp-endpoint:8000
HITACHI_ACCESS_KEY_ID=your-access-key
HITACHI_SECRET_ACCESS_KEY=your-secret-key
HITACHI_BUCKET=dms-connector

# Must match the connector EXACTLY, or no documents are found.
# Document paths in the connector log look like
#   storage="connector/dms/Live/document/<cid>"
# -> the prefix is everything before /document, i.e. /connector/dms/Live
HITACHI_OBJECT_PREFIX=/connector/dms/Live

# --- Copy only if the connector sets them -----------------------------------
#HITACHI_REGION=us-east-1
#HITACHI_USE_PATH_STYLE=true
#HITACHI_INSECURE_SKIP_VERIFY=true      # if HCP uses a self-signed certificate
#HITACHI_HTTP_TIMEOUT=60s

# Directory for temporary PDF copies (needs space for ~4 of the largest PDFs).
#TEMP_DIR=/tmp
